# ==========================================
# ЗАДАНИЕ 1: Реализация структуры и обходов
# ==========================================

def inorder_traversal(node):
    """Симметричный обход (In-order): Лево -> Корень -> Право"""
    if node is None:
        return []
    # Рекурсивно обходим левое поддерево, добавляем корень, обходим правое
    return inorder_traversal(node['left']) + [node['val']] + inorder_traversal(node['right'])

def preorder_traversal(node):
    """Прямой обход (Pre-order): Корень -> Лево -> Право"""
    if node is None:
        return []
    # Сначала корень, потом левое, потом правое
    return [node['val']] + preorder_traversal(node['left']) + preorder_traversal(node['right'])

def postorder_traversal(node):
    """Обратный обход (Post-order): Лево -> Право -> Корень"""
    if node is None:
        return []
    # Сначала левое, потом правое, потом корень
    return postorder_traversal(node['left']) + postorder_traversal(node['right']) + [node['val']]

# ==========================================
# ЗАДАНИЕ 2: Инвертирование дерева
# ==========================================

def invert_tree(node):
    """
    Инвертирует бинарное дерево.
    Меняет местами левого и правого потомка для каждого узла.
    """
    if node is None:
        return None
    
    # Меняем местами ссылки на левого и правого ребенка
    node['left'], node['right'] = node['right'], node['left']
    
    # Рекурсивно применяем ту же операцию к потомкам
    invert_tree(node['left'])
    invert_tree(node['right'])
    
    return node

def tree_to_list_level_order(node):
    """
    Вспомогательная функция для вывода дерева в виде массива (по уровням).
    Нужна для проверки результата Задания 2.
    """
    if node is None:
        return []
    
    result = []
    queue = [node]
    
    while queue:
        current = queue.pop(0)
        if current:
            result.append(current['val'])
            queue.append(current['left'])
            queue.append(current['right'])
        else:
            result.append(None)
            
    # Убираем лишние None в конце
    while result and result[-1] is None:
        result.pop()
        
    return result

