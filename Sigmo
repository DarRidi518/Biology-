# ПРИМЕР ИСПОЛЬЗОВАНИЯ
# ==========================================

if __name__ == "__main__":
    # Создаем дерево из примера с помощью словарей:
    #      4
    #    /   \
    #   2     7
    #  / \   / \
    # 1   3 6   9
    
    root = {
        'val': 4,
        'left': {
            'val': 2,
            'left': {'val': 1, 'left': None, 'right': None},
            'right': {'val': 3, 'left': None, 'right': None}
        },
        'right': {
            'val': 7,
            'left': {'val': 6, 'left': None, 'right': None},
            'right': {'val': 9, 'left': None, 'right': None}
        }
    }

    print("--- Задание 1: Обходы дерева ---")
    print(f"Симметричный (In-order): {inorder_traversal(root)}")
    print(f"Прямой (Pre-order):      {preorder_traversal(root)}")
    print(f"Обратный (Post-order):   {postorder_traversal(root)}")

    print("\n--- Задание 2: Инвертирование ---")
    print(f"Исходное дерево (массив): {tree_to_list_level_order(root)}")
    
    # Инвертируем
    inverted_root = invert_tree(root)
    
    print(f"Инвертированное дерево:   {tree_to_list_level_order(inverted_root)}")
